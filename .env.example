# ═══════════════════════════════════════════════════
# PrecisionRx AI — Environment Variables Template
# ═══════════════════════════════════════════════════
# Copy to .env and fill in values. Never commit .env!

# ── App Security ─────────────────────────────────
SECRET_KEY=your-super-secret-key-at-least-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-32-chars

# ── PostgreSQL ────────────────────────────────────
POSTGRES_DB=precisionrx
POSTGRES_USER=precisionrx
POSTGRES_PASSWORD=changeme_strong_password_here

# ── MongoDB ───────────────────────────────────────
MONGO_USER=precisionrx
MONGO_PASSWORD=changeme_mongo_password

# ── Redis ─────────────────────────────────────────
REDIS_PASSWORD=precisionrx123

# ── RabbitMQ ──────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── S3 / MinIO (Data Lake) ────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=precisionrx-data-lake

# ── MLflow ───────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5001
MLFLOW_EXPERIMENT_NAME=precisionrx-models

# ── FHIR Integration ─────────────────────────────
FHIR_BASE_URL=https://your-ehr-fhir-endpoint/R4
FHIR_CLIENT_ID=your-fhir-client-id
FHIR_CLIENT_SECRET=your-fhir-client-secret

# ── Frontend (Next.js) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_URL=http://localhost:3000

# ── Federated Learning ───────────────────────────
FL_SERVER_HOST=0.0.0.0
FL_SERVER_PORT=8080
FL_NUM_ROUNDS=10
FL_MIN_CLIENTS=2
FL_DIFFERENTIAL_PRIVACY_EPSILON=1.0

# ── Monitoring / Observability ───────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── HIPAA Compliance ─────────────────────────────
ENCRYPTION_KEY_AES256=your-base64-encoded-256-bit-key-here
AUDIT_LOG_RETENTION_DAYS=2190  # 6 years (HIPAA minimum)
DATA_RESIDENCY_REGION=us-east-1
